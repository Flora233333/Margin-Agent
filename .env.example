# 复制为 .env 后填写。.env 已被 .gitignore 忽略，不要提交真实密钥。

# ---- 模型（OpenAI 兼容接口：DeepSeek / vLLM 部署的自训模型都可以）----
MARGIN_LLM_BASE_URL=https://<OpenAI 兼容网关地址>/v1
# 学校网关的模型名：DeepSeek = v4.1-flash（主用），GLM = glm5.3-flash（备用）。
# 不填默认 DeepSeek；脚本可用 --model 临时换，后台服务一律用这里的模型。
MARGIN_LLM_MODEL=DeepSeek
MARGIN_LLM_API_KEY=

# ---- 语料（只读）----
# blocks.jsonl：每行一个文档块（doc_id / block_id / text / section_path ...）
MARGIN_BLOCKS_PATH=D:/competition/finetune/data/blocks/blocks.jsonl
# canonical manifest：提供 doc_id -> 文件名（作为文档标题参与 BM25）
MARGIN_MANIFEST_PATH=D:/competition/finetune/data/canonical/h1.1.0-rc/manifest.json
# 实体别名表：精确匹配公司名、债券简称、证券代码等
MARGIN_ALIAS_PATH=D:/competition/finetune/data/canonical/h1.1.0-rc/entity_alias_catalog.jsonl
# BM25 索引缓存目录（首次运行自动构建）
MARGIN_CACHE_DIR=.cache

# ---- 数据库（docker compose 里的 PostgreSQL + pgvector）----
# 密码要和 compose 一致：compose 读本文件的 MARGIN_PG_PASSWORD，不填则为 margin_dev
MARGIN_PG_PASSWORD=margin_dev
MARGIN_DATABASE_URL=postgresql://margin:margin_dev@127.0.0.1:5432/margin
# ---- 任务队列（compose 的 rabbitmq 服务，D19）----
# 密码要和 compose 一致：compose 读本文件的 MARGIN_MQ_PASSWORD，不填则为 margin_dev
MARGIN_MQ_PASSWORD=margin_dev
MARGIN_BROKER_URL=amqp://margin:margin_dev@127.0.0.1:5672//
# Redis：M2 起推送思考片段（不再是任务队列）
MARGIN_REDIS_URL=redis://127.0.0.1:6379/0

# ---- 向量检索（可选；EMBEDDING_BASE_URL 留空则只用 BM25 + 别名两路）----
# 由 compose 的 embedding 服务提供（llama.cpp 容器）；向量先用 import_vectors.py 导入 PG
MARGIN_EMBEDDING_BASE_URL=http://127.0.0.1:18082/v1
MARGIN_EMBEDDING_MODEL=rc6-local-qwen3emb06b-q8_0-v2
