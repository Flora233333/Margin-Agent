# 复制为 .env 后填写。.env 已被 .gitignore 忽略，不要提交真实密钥。

# ---- 模型（OpenAI 兼容接口：DeepSeek / vLLM 部署的自训模型都可以）----
MARGIN_LLM_BASE_URL=https://<OpenAI 兼容网关地址>/v1
# 学校网关的模型名：DeepSeek = v4.1-flash（主用），GLM = glm5.3-flash（备用）。
# 网关公用、时好时坏，也可以不填这一行，运行时用 --model 指定。
MARGIN_LLM_MODEL=DeepSeek
MARGIN_LLM_API_KEY=

# ---- 语料（只读）----
# blocks.jsonl：每行一个文档块（doc_id / block_id / text / section_path ...）
MARGIN_BLOCKS_PATH=D:/competition/finetune/data/blocks/blocks.jsonl
# canonical manifest：提供 doc_id -> 文件名（作为文档标题参与 BM25）
MARGIN_MANIFEST_PATH=D:/competition/finetune/data/canonical/h1.1.0-rc/manifest.json
# 实体别名表：精确匹配公司名、债券简称、证券代码等
MARGIN_ALIAS_PATH=D:/competition/finetune/data/canonical/h1.1.0-rc/entity_alias_catalog.jsonl
# BM25 索引缓存目录（首次运行自动构建）
MARGIN_CACHE_DIR=.cache

# ---- 向量检索（可选；留空则只用 BM25 + 别名两路）----
MARGIN_CHROMA_PATH=
MARGIN_EMBEDDING_BASE_URL=
MARGIN_EMBEDDING_MODEL=text-embedding-qwen3-embedding-0.6b
